# Kora Health — environment variables. Copy to .env.local for development.
# Never commit real values. Server-only variables must never be prefixed
# with NEXT_PUBLIC_. See docs/DEPLOYMENT.md.

# --- Environment -------------------------------------------------------------
# development | preview | production. Sample (is_demo) profiles are hidden in production.
NEXT_PUBLIC_KORA_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase Auth (public values; safe in the browser) ----------------------
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server-only secrets -----------------------------------------------------
# Service role key: account deletion and signed storage URLs only.
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection for the kora_app role (see docs/DEPLOYMENT.md). On
# Supabase use the transaction pooler (port 6543).
DATABASE_URL=postgres://kora_app:password@localhost:5432/kora_dev
# verify (default; validates TLS certificate) | disable (local only)
DATABASE_SSL=disable
# PEM CA for DATABASE_SSL=verify, e.g. Supabase's root certificate ("\n" escapes allowed).
DATABASE_CA_CERT=
DATABASE_POOL_MAX=5

# Kora AI (optional). Without a key, emergency guidance and rule-based
# matching still work; conversational AI shows as unavailable.
ANTHROPIC_API_KEY=
KORA_AI_MODEL=claude-opus-5-5
KORA_AI_EFFORT=medium

# Payments (optional). Both required to enable billing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Scheduled jobs: Vercel Cron sends "Authorization: Bearer $CRON_SECRET".
CRON_SECRET=

# "true" once Supabase Storage buckets from migration 0007 exist.
KORA_STORAGE_ENABLED=false
